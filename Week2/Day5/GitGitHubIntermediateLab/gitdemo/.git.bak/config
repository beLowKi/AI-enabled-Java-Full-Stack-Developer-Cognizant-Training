[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	ignorecase = true
[remote "origin"]
	url = https://github.com/beLowKi/revature-gitdemo.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[pull]
	rebase = false
[branch "feature/employee-management"]
	remote = origin
	merge = refs/heads/feature/employee-management
